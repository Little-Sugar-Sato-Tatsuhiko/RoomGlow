{
  "name": "roomglow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --exclude 'node_modules/**' --exclude 'data/**' --exclude 'videos/**' --exclude 'dist/**' --exclude '*.timestamp-*.mjs' --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:electron-server": "node scripts/build-electron-server.mjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:start": "npm run build && npm run build:electron-server && npm run electron:rebuild && electron .",
    "electron:build": "npm run build && npm run build:electron-server && npm run electron:rebuild && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "suncalc": "^2.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.roomglow.app",
    "productName": "RoomGlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/server-bundle.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
